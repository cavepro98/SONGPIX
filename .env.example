# New Supabase project
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxx"
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="your-project-id"

# Client-side exposure for Vite
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Optional Vercel/Next-style aliases accepted by this app
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# Public app URL used by payment webhooks
PUBLIC_SITE_URL="https://your-domain.com"
CORS_ALLOWED_ORIGINS="https://your-domain.com"
PAYMENT_STATUS_SECRET="change-me-status-secret"

# PushinPay private API token (server only)
PUSHINPAY_TOKEN=""
